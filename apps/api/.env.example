# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database — local Docker Postgres on port 5434 (isolated from any other
# Postgres on this machine). Start it with: docker compose up -d
# For Supabase cloud, swap to: postgresql://postgres:[pw]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://cafespace:cafespace@localhost:5434/cafespace

# Auth (Supabase JWT secret — Project Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=replace-me

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# AI providers (optional in V0 dev — required when AI waiter is wired up)
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Payments (optional in V0 dev)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
