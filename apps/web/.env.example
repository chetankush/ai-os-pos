# Backend API base URL. In dev this is the local Fastify server.
# In production, point this at your Railway/Fly URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase project — frontend uses these for auth (SSR + browser)
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
